<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="sniff_indoor">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- ================= SCIANY ================= -->
    <model name="walls">
      <static>true</static>

      <!-- sciany zewnetrzne -->
      <link name="w_north">
        <pose>0 5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>12.15 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.15 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <link name="w_south">
        <pose>0 -5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>12.15 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.15 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <link name="w_west">
        <pose>-6 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 10.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 10.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <link name="w_east">
        <pose>6 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 10.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 10.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <!-- sciana polnocna korytarza: przejscie x = -2..0 -->
      <link name="w_cor_n_left">
        <pose>-4 1.5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>4.0 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>

      <link name="w_cor_n_right">
        <pose>3 1.5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.0 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>

      <!-- sciana poludniowa korytarza: przejscie x = 2..4 -->
      <link name="w_cor_s_left">
        <pose>-2 -1.5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.0 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>

      <link name="w_cor_s_right">
        <pose>5 -1.5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>

      <!-- podzial pomieszczen polnocnych -->
      <link name="w_div_north">
        <pose>0 3.25 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 3.5 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 3.5 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>

      <!-- czesciowa przegroda w pom. poludniowym (test frontier exploration) -->
      <link name="w_div_south">
        <pose>1 -4 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 2.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 2.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================= PRZESZKODY ================= -->
    <model name="furniture">
      <static>true</static>

      <link name="cabinet">
        <pose>3 3 0.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>

      <link name="bin">
        <pose>-3.5 3 0.4 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>

      <link name="table">
        <pose>-4 -3.5 0.375 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 0.6 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.6 0.75</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>

      <link name="pillar_corridor">
        <pose>2 0 0.6 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>

      <link name="box_small">
        <pose>5 -3 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
