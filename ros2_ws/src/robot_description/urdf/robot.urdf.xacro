<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_wheeled_robot">

  <!-- ================= GEOMETRIA ================= -->
  <xacro:property name="base_length" value="0.2525"/>
  <xacro:property name="base_width"  value="0.126"/>
  <xacro:property name="base_height" value="0.094"/>
  <xacro:property name="base_mass"   value="2.0"/> <!-- Dodana masa kadłuba [kg] -->

  <xacro:property name="wheel_radius" value="0.042"/>
  <xacro:property name="wheel_width"  value="0.0502"/>
  <xacro:property name="wheel_mass"   value="0.2"/> <!-- Dodana masa koła [kg] -->

  <xacro:property name="wheel_x_offset" value="0.084"/>
  <xacro:property name="wheel_y_offset" value="${(base_width/2) + (wheel_width/2)}"/>
  <xacro:property name="wheel_z_offset" value="${-base_height/2}"/>

  <!-- ================= MAKRA INERCJI ================= -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <!-- Zwróć uwagę na poprawione przypisanie zmiennych w w(width), h(height), d(depth/length) -->
      <inertia ixx="${(m/12) * (w*w + h*h)}" ixy="0.0" ixz="0.0" 
               iyy="${(m/12) * (d*d + h*h)}" iyz="0.0" 
               izz="${(m/12) * (d*d + w*w)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0" 
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0" 
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= MATERIAŁY RVIZ ================= -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ================= WIRTUALNY KORZEŃ (DLA SLAM I KDL) ================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Przesuwamy base_link w górę tak, by base_footprint "ślizgał się" idealnie po podłodze (Z=0) -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ================= KADŁUB ================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <!-- Fizyka kadłuba -->
    <xacro:box_inertia m="${base_mass}" w="${base_width}" d="${base_length}" h="${base_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ================= MAKRO KOŁA ================= -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <!-- Fizyka koła -->
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${name}_link">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1>
      <mu2>0.1</mu2>
    </gazebo>
  </xacro:macro>

  <!-- ================= INSTANCJE KÓŁ ================= -->
  <xacro:wheel name="front_left" x="${wheel_x_offset}"  y="${wheel_y_offset}"/>
  <xacro:wheel name="mid_left"   x="0.0"                y="${wheel_y_offset}"/>
  <xacro:wheel name="rear_left"  x="-${wheel_x_offset}" y="${wheel_y_offset}"/>

  <xacro:wheel name="front_right" x="${wheel_x_offset}"  y="-${wheel_y_offset}"/>
  <xacro:wheel name="mid_right"   x="0.0"                y="-${wheel_y_offset}"/>
  <xacro:wheel name="rear_right"  x="-${wheel_x_offset}" y="-${wheel_y_offset}"/>

  <!-- ================= WTYCZKA GAZEBO (NAPĘD 6x6) ================= -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30.0</update_rate>

      <!-- Parametr kluczowy dla 6 kół -->
      <num_wheel_pairs>3</num_wheel_pairs>
      
      <!-- Lewa strona -->
      <left_joint>front_left_joint</left_joint>
      <left_joint>mid_left_joint</left_joint>
      <left_joint>rear_left_joint</left_joint>
      
      <!-- Prawa strona -->
      <right_joint>front_right_joint</right_joint>
      <right_joint>mid_right_joint</right_joint>
      <right_joint>rear_right_joint</right_joint>

      <!-- Kinematyka wyliczona z parametrów XACRO -->
      <wheel_separation>${2 * wheel_y_offset}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>

      <!-- Ograniczenia -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <!-- Wyjścia (Odometria i TF) -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!--LIDAR-->

  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.055"/>
  <xacro:property name="lidar_mass"   value="0.190"/>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${lidar_mass}"/>
      <inertia ixx="${(lidar_mass/12) * (3*lidar_radius*lidar_radius + lidar_height*lidar_height)}" ixy="0" ixz="0" 
               iyy="${(lidar_mass/12) * (3*lidar_radius*lidar_radius + lidar_height*lidar_height)}" iyz="0" 
               izz="${(lidar_mass/2) * (lidar_radius*lidar_radius)}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${base_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor type="ray" name="rplidar_a1_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize> 
      <update_rate>5.5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min> 
          <max>12.0</max> 
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <argument>~/out:=scan</argument> 
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>